# ── Your data: never committed ──────────────────────────────────────────────
# The app database (SQLite) and its write-ahead log / shared-memory files.
data/*
!data/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Profile, CV and search settings
cv.md
cv.md.bak*
article-digest.md
voice-dna.md
portals.yml
portals.yml.bak-*
config/profile.yml
config/*.bak-*
config/cv-facts.json
modes/

# Generated files and personal notes
reports/*
!reports/.gitkeep
output/*
!output/.gitkeep
jds/*
!jds/.gitkeep
writing-samples/*
!writing-samples/README.md
interview-prep/
.career-ops-web/

# Personal exports and archives
*.csv
*.zip

# ── Build and tooling ──────────────────────────────────────────────────────
node_modules/
web/.next*/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
.env
.env.*
*.log
.DS_Store
tmp/
.claude/
.playwright-mcp/
